# Input parametre
c_TAN <- 3000 # Total Ammonium Nitrogen (g/m3)
pH <- 7
temp <- 20 # deg C
Kg <- 0.001 # Gas transfer coefficient (m/s)
A <- 10 # Overfladeareal (m2) - eksempel værdi
# 1. Beregn fri ammoniak (c_NH3) i væsken
c_H <- 10^(-pH)
Ka <- 10^-(0.0905 + 2729.31 / (temp + 273.15))
c_NH3_liq <- c_TAN / (1 + c_H / Ka) # g/m3 (ofte målt som g N/m3)
# 2. Beregn den dimensionsløse Henry's konstant (H = C_liquid / C_gas)
# Vi bruger SI-enheder direkte for at undgå fejl:
K_h_SI <- 0.59          # mol/(m3 * Pa)
R_SI <- 8.314           # (Pa * m3)/(mol * K)
T_kelvin <- temp + 273.15
# H_dim beskriver forholdet: [Koncentration i vand] / [Koncentration i luft]
H_dim <- K_h_SI * R_SI * T_kelvin
H_dim
c_NH3_liq
c_NH3_liq / H_dim
# 4. Massetransport/Volatilisering rate (dc_NH3/dt)
# Differentialligningen for tab udtrykt ved gas-overførselskoefficienten (Kg):
# dc_NH3_liq/dt = - (A * Kg * cg_eq) / V  (hvis det er ændring i koncentration over tid i et volumen V)
# Hvis det er den totale masse pr. tid (g/s):
dM_NH3_dt <- - A * Kg * (cg_eq - 0)
# 3. Beregn ligevægtskoncentrationen i gasfasen lige over overfladen (cg)
# Da H_dim = c_NH3_liq / cg_eq, må cg_eq være:
cg_eq <- c_NH3_liq / H_dim  # g/m3
# 4. Massetransport/Volatilisering rate (dc_NH3/dt)
# Differentialligningen for tab udtrykt ved gas-overførselskoefficienten (Kg):
# dc_NH3_liq/dt = - (A * Kg * cg_eq) / V  (hvis det er ændring i koncentration over tid i et volumen V)
# Hvis det er den totale masse pr. tid (g/s):
dM_NH3_dt <- - A * Kg * (cg_eq - 0)
# 5. Hvis diff ligning udtrykkes via væskefase massetransport, dvs Kl fås i stedet
Kg
# 5. Hvis diff ligning udtrykkes via væskefase massetransport, dvs Kl fås i stedet
Kl <- Kg/H
Kl
# 5. Hvis diff ligning udtrykkes via væskefase massetransport, dvs Kl fås i stedet
Kl <- Kg/H_dim
Kl
# her skal gas koncenrtationen omregnes til væske fase enhed
dM_NH3_dt <- - A * Kl * (c_NH3 - 0 * H)
# 4. Massetransport/Volatilisering rate (dc_NH3/dt)
# Differentialligningen for tab udtrykt ved gas-overførselskoefficienten (Kg):
# dc_NH3_liq/dt = - (A * Kg * cg_eq) / V  (hvis det er ændring i koncentration over tid i et volumen V)
# Hvis det er den totale masse pr. tid (g/s):
dM_NH3_dt_gas <- - A * Kg * (cg_eq - 0)
# 5. Hvis diff ligning udtrykkes via væskefase massetransport, dvs Kl fås i stedet
Kl <- Kg/H_dim
# her skal gas koncenrtationen omregnes til væske fase enhed
dM_NH3_dt_liq <- - A * Kl * (c_NH3 - 0 * H)
# Input parametre
c_TAN <- 3000 # Total Ammonium Nitrogen (g/m3)
pH <- 7
temp <- 20 # deg C
Kg <- 0.001 # Gas transfer coefficient (m/s)
A <- 10 # Overfladeareal (m2) - eksempel værdi
# 1. Beregn fri ammoniak (c_NH3) i væsken
c_H <- 10^(-pH)
Ka <- 10^-(0.0905 + 2729.31 / (temp + 273.15))
c_NH3_liq <- c_TAN / (1 + c_H / Ka) # g/m3 (ofte målt som g N/m3)
# 2. Beregn den dimensionsløse Henry's konstant (H = C_liquid / C_gas)
# Vi bruger SI-enheder direkte for at undgå fejl:
K_h_SI <- 0.59          # mol/(m3 * Pa)
R_SI <- 8.314           # (Pa * m3)/(mol * K)
T_kelvin <- temp + 273.15
# H_dim beskriver forholdet: [Koncentration i vand] / [Koncentration i luft]
H_dim <- K_h_SI * R_SI * T_kelvin # væske/gas forhold
# 3. Beregn ligevægtskoncentrationen i gasfasen lige over overfladen (cg)
# Da H_dim = c_NH3_liq / cg_eq, må cg_eq være:
cg_eq <- c_NH3_liq / H_dim  # g/m3
# 4. Massetransport/Volatilisering rate (dc_NH3/dt)
# Differentialligningen for tab udtrykt ved gas-overførselskoefficienten (Kg):
# dc_NH3_liq/dt = - (A * Kg * cg_eq) / V  (hvis det er ændring i koncentration over tid i et volumen V)
# Hvis det er den totale masse pr. tid (g/s):
dM_NH3_dt_gas <- - A * Kg * (c_NH3_liq/H_dim - 0)
# 5. Hvis diff ligning udtrykkes via væskefase massetransport, dvs Kl fås i stedet
Kl <- Kg/H_dim
# her skal gas koncenrtationen omregnes til væske fase enhed
dM_NH3_dt_liq <- - A * Kl * (c_NH3_liq - 0 * H_dim)
k = log(0.1*3/3)/(24*60*60)
k
