# slurry temp and slurry heights/volumes.
ff <- list.files('../Data to Frederik', full.names = T)
ff <- ff[grepl('.csv|.CSV', ff)]
dat <- data.table()
for (file_name in ff){
print(file_name)
dat1 <- fread(file_name)
colnames(dat1)[!colnames(dat1) %in% "Time"]
dat_long1 <- melt(dat1, measure.vars = colnames(dat1)[!colnames(dat1) %in% "Time"])
dat_long1[, ":="(datetime = as.POSIXct(
Time,
format = "%d-%m-%Y %H:%M",
tz = "UTC"))]
dat_long1[, Time := NULL]
dat_long1[, tank := fifelse(
grepl("T\\d+", variable),
sub(".*T(\\d+).*", "\\1", variable),
"1"
)]
dat_long1[, dataset := fifelse(grepl("1", file_name), "storemis_SPC1_2026",
fifelse(grepl("2", file_name), "storemis_SPC2_2026",
fifelse(grepl("3", file_name), "storemis_SPC3_2026",
fifelse(grepl("4", file_name), "storemis_SPN4_2026",
fifelse(grepl("5", file_name), "storemis_SPN5_2026", "storemis_SPC6_2026")))))]
dat <- rbind(dat, dat_long1)
}
area <- data.table(dataset = c('storemis_SPC1_20261', 'storemis_SPC1_20262',
'storemis_SPC2_20261', 'storemis_SPC2_20262',
'storemis_SPC3_20261', 'storemis_SPC3_20262',
'storemis_SPN4_20261',
'storemis_SPN5_20261', 'storemis_SPN5_20262',
'storemis_SPC6_20261'),
area = c(pi * 15.45^2, pi * 15.45^2,
pi * 15.52^2, pi * 10.78^2,
pi * 17.15^2, pi * 14.10^2,
pi * 9.77^2,
pi * 10.93^2, pi * 10.93^2,
pi * 11.29^2))
dat[, variable := as.character(variable)]
# hourly measurements
dat[, ":="(year = year(datetime), doy = yday(datetime), hour = hour(datetime))]
dat_hour <- copy(dat)
dat_hour <- dat_hour[, .(datetime = mean(datetime), hour_value = mean(value, na.rm = TRUE)),
by = .(variable, tank, dataset, year, doy, hour)]
# clean names
dat_hour[, variable := gsub(" ", "_", variable)]
dat_hour[, variable := sub("^T\\d+_", "", variable)]
dat_hour[, variable := sub("_T\\d+$", "", variable)]
dat_hour[, position := 0]
dat_hour[, position := fifelse(grepl("0,5", variable), 0.5,
fifelse(grepl("1,5", variable), 1.5,
fifelse(grepl("2,5", variable), 2.5,
fifelse(grepl("3,5", variable), 3.5, position))))]
temp_vars <- c("Temp_0,5", "Temp_1,5", "Temp_2,5", "Temp_3,5","Temp_ude","Temp_top")
dat_temp <- dat_hour[variable %in% temp_vars]
dat_temp_wide <- dcast(dat_temp,
datetime + dataset + tank + year + doy + hour ~ variable,
value.var = "hour_value")
dat_manure <- dat_hour[variable %in% c("Gylle_niveau_cm", "Manure_volume_m3")]
dat_manure[, .(min(hour_value), max(hour_value)), by = .(dataset, tank, variable)]
starttime <- as.POSIXct("2024-11-29 07:29:49", tz = "UTC")
endtime   <- as.POSIXct("2025-03-13 09:31:17", tz = "UTC")
dat_manure <- dat_manure[!(variable %in% c("Gylle_niveau_cm", "Manure_volume_m3") &
dataset  == "storemis_SPC2_2026" &
tank     == 1 &
datetime >= starttime &
datetime <= endtime)]
new_rows <- dat_manure[dataset == "storemis_SPC2_2026" & tank == 1, ]
new_rows <- new_rows[c(1,2,3,4)]
new_rows$datetime <- c(as.POSIXct("2025-02-05 12:00:00", tz = "UTC"),
as.POSIXct("2025-02-27 12:00:00", tz = "UTC"),
as.POSIXct("2025-02-05 12:00:00", tz = "UTC"),
as.POSIXct("2025-02-27 12:00:00", tz = "UTC"))
new_rows$variable <- c('Manure_volume_m3','Manure_volume_m3','Gylle_niveau_cm','Gylle_niveau_cm')
new_rows$hour_value <- c(1876, 2398.8, 248, 317)
dat_manure <- rbind(dat_manure, new_rows)
starttime <- as.POSIXct("2025-08-23 00:00:00", tz = "UTC")
endtime   <- as.POSIXct("2025-10-12 11:30:15", tz = "UTC")
dat_manure <- dat_manure[!(variable %in% c("Gylle_niveau_cm", "Manure_volume_m3") &
dataset  == "storemis_SPC3_2026" &
tank     == 2 &
datetime >= starttime &
datetime <= endtime)]
new_rows <- dat_manure[dataset == "storemis_SPC3_2026" & tank == 2, ]
new_rows <- new_rows[c(1,2)]
new_rows$datetime <- c(as.POSIXct("2025-09-06 12:00:00", tz = "UTC"),
as.POSIXct("2025-09-06 12:00:00", tz = "UTC"))
new_rows$variable <- c('Manure_volume_m3','Gylle_niveau_cm')
new_rows$hour_value <- c(500, 80)
dat_manure <- rbind(dat_manure, new_rows)
#ggplot(dat_manure[variable == "Manure_volume_m3"], aes(datetime, hour_value)) + geom_point() + facet_grid(~dataset+tank)
dat_manure[variable == 'Gylle_niveau_cm' & hour_value < 20, hour_value := 20] # change to 1 m3 manure if negatives appear
dat_manure[variable == 'Manure_volume_m3' & dataset == "storemis_SPC3_2026",
hour_value := fifelse(tank == 1 & hour_value < 184, 184, fifelse(tank == 2 & hour_value < 125, 125, hour_value)) ] # change to 1 m3 manure if negatives appear
dat_manure[, ":="(hour = hour(datetime), year = year(datetime), doy = yday(datetime))]
dat_manure_wide <- dcast(dat_manure,
datetime + dataset + tank + year + doy + hour ~ variable,
value.var = "hour_value")
ggplot(dat_manure[variable == "Gylle_niveau_cm" & dataset == 'storemis_SPN5_2026'], aes(datetime, hour_value)) + geom_point() + facet_grid(~dataset+tank)
dat_manure[variable == "Gylle_niveau_cm" & dataset == 'storemis_SPN5_2026', min(datetime)]
dat_manure[variable == "Gylle_niveau_cm" & dataset == 'storemis_SPN5_2026' & tank == 2, min(datetime)]
dat_manure[variable == "Gylle_niveau_cm" & dataset == 'storemis_SPN5_2026' & tank == 1, min(datetime)]
test <- dat_manure[variable == "Gylle_niveau_cm" & dataset == 'storemis_SPN5_2026' & tank == 1, min(datetime)]
## correct SPN5 level data
new_rows <- dat_manure[dataset == "storemis_SPN5_2026" & tank == 2, ]
new_rows <- new_rows[c(1,2)]
new_rows$datetime <- c(as.POSIXct("2024-12-04 12:00:00", tz = "UTC"),
as.POSIXct("2024-12-04 12:00:00", tz = "UTC"))
new_rows$variable <- c('Manure_volume_m3','Gylle_niveau_cm')
aera
area
new_rows$hour_value <- c(1245, 332)
dat_manure <- rbind(dat_manure, new_rows)
## correct SPC6 level data
new_rows <- dat_manure[dataset == "storemis_SPC6_2026" & tank == 2, ]
## correct SPC6 level data
new_rows <- dat_manure[dataset == "storemis_SPC6_2026", ]
View(new_rows)
rm(list=ls())
