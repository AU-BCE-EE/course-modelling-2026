dat_long1[, ":="(datetime = as.POSIXct(
Time,
format = "%d-%m-%Y %H:%M",
tz = "UTC"))]
dat_long1[, Time := NULL]
dat_long1[, tank := fifelse(
grepl("T\\d+", variable),
sub(".*T(\\d+).*", "\\1", variable),
