Temp_35 = as.numeric(Temp_35))]
joined[, ":="(
sd_Temp_05 = sd(Temp_05, na.rm = TRUE),
sd_Temp_15 = sd(Temp_15, na.rm = TRUE),
sd_Temp_25 = sd(Temp_25, na.rm = TRUE),
sd_Temp_35 = sd(Temp_35, na.rm = TRUE)
), by = .(dataset, tank, year, doy)]
joined[, ":="(
Temp_05_f = fifelse(sd_Temp_05 < 1, Temp_05, NA_real_),
Temp_15_f = fifelse(sd_Temp_15 < 1, Temp_15, NA_real_),
Temp_25_f = fifelse(sd_Temp_25 < 1, Temp_25, NA_real_),
Temp_35_f = fifelse(sd_Temp_35 < 1, Temp_35, NA_real_)
)]
# remove specific errors in sensors.
joined[dataset == 'storemis_SPC1_2026' & tank == "1", Temp_15_f := fifelse(Temp_15_f < 2, NA_real_, Temp_15_f)]
joined[dataset == 'storemis_SPC1_2026' & tank == "2", Temp_05_f := fifelse(Temp_05_f < 2, NA_real_, Temp_05_f)]
joined[, ":="(Temp_05_f = fifelse(Temp_05_f < 0, 0, Temp_05_f),
Temp_15_f = fifelse(Temp_15_f < 0, 0, Temp_15_f),
Temp_25_f = fifelse(Temp_25_f < 0, 0, Temp_25_f),
Temp_35_f = fifelse(Temp_35_f < 0, 0, Temp_35_f))]
# interpolate missing heights
joined[, slurry_height := approx(datetime[!is.na(slurry_height)], slurry_height[!is.na(slurry_height)], datetime)$y,
by = .(dataset, tank)]
# estimate mean temp based on slurry height
joined[, temp_C := fifelse(slurry_height < 1.6, Temp_05_f,
fifelse(slurry_height >= 1.6 & slurry_height < 2.6,
rowMeans(cbind(Temp_05_f, Temp_15_f), na.rm = TRUE),
fifelse(slurry_height >= 2.6 & slurry_height < 3.6,
rowMeans(cbind(Temp_05_f, Temp_15_f, Temp_25_f), na.rm = TRUE),
rowMeans(cbind(Temp_05_f, Temp_15_f, Temp_25_f, Temp_35_f), na.rm = TRUE))))]
#ggplot(joined, aes(datetime, slurry_mass, col = tank)) + geom_point() +
#  facet_grid(tank~dataset)
#ggplot(joined, aes(datetime, slurry_height, col = tank)) + geom_point() +
#  facet_grid(tank~dataset)
#ggplot(joined, aes(datetime, temp_C, col = tank)) + geom_point() +
#  facet_wrap(tank~dataset)
# emission
emis <- setDT(read.xlsx('../Data to Frederik/CH4_emission_data_concentration.v2.xlsx'))
emis[, ":="(datetime = as.POSIXct(Date * 86400, origin = "1899-12-30", tz = "UTC"),
CH4_emis_rate = `Emission.(kg/h)` * 1000 * 24, dataset = Tank)][, ":="(Tank = NULL, Date = NULL)]
emis <- emis[!is.na(CH4_emis_rate)]
emis[, datetime := as.POSIXct(paste0(datetime, " 12:00:00 UTC"))]
emis[, ":="(year = year(datetime),
doy = yday(datetime),
hour = hour(datetime))]
emis[, dataset := paste0("storemis_", dataset,"_2026")]
# CHANGE NAME OF DATASET IN EMISSION!
#ggplot(emis, aes(datetime, CH4_emis_rate)) + geom_point() + facet_wrap(~dataset)
emis <- emis[, .(datetime, doy, hour, year, dataset, CH4_emis_rate)]
joined2 <- merge.data.table(joined, emis, by = c('datetime', 'dataset','year','doy','hour'), all = T)
joined2[, sum_slurry_mass := sum(slurry_mass, na.rm = T), by = .(dataset, datetime)]
joined2 <- joined2[order(dataset, datetime)]
## need to merged with slurry analysis data
slurry_comp <- setDT(read.xlsx('../data/samples_overview.xlsx'))
slurry_comp[, dataset := fifelse(grepl('Enghav', adresse), 'storemis_SPC1_2026',
fifelse(grepl('Egebjerg', adresse), 'storemis_SPC2_2026',
fifelse(grepl('Bavnen', adresse), 'storemis_SPC3_2026',
fifelse(grepl('Sorøvej', adresse), 'storemis_SPN4_2026',
fifelse(grepl('Bjergby', adresse), 'storemis_SPN5_2026',
fifelse(grepl('Bakkendrup', adresse), 'storemis_SPC6_2026',
'unknown'))))))]
slurry_comp[, tank := tankID]
#remove pretanks
slurry_comp <- slurry_comp[!is.na(tank)]
slurry_comp[, ":="(TAN_conc = as.numeric(`tan_gN/kg`), VFA_conc = as.numeric(`vfa_g/kg`), pH = as.numeric(pH))]
slurry_comp[, datetime := as.POSIXct(dato * 86400, origin = "1899-12-30", tz = "UTC")]
slurry_comp[type != "top", .(TAN_conc = mean(TAN_conc, na.rm = T),
VFA_Conc = mean(VFA_conc, na.rm = T),
pH = mean(pH, na.rm = T)), by = .(datetime, dataset, tank)]
slurry_comp <- slurry_comp[, .(datetime, tank = as.character(tank), dataset, TAN_conc, VFA_conc, pH)]
joined3 <- merge.data.table(joined2, slurry_comp, by = c('datetime','dataset','tank'), all = T)
joined3 <- joined3[order(dataset, tank, datetime)]
dat_select <- joined3[,.(datetime, CH4_emis_rate, NH3_emis_rate = NA, VFA_conc,
TAN_conc, slurry_mass, temp_C, pH, wash_water = 0,
feed_intake = 0, energy_content = 0, animals = 0, dataset = paste0(dataset, tank))]
##
dat_select[, dataset := gsub('NA','', dataset)]
dat_select[, names(dat_select) := lapply(.SD, function(x) {
if (is.numeric(x)) x[is.nan(x)] <- NA
x
})]
# now we need to remove the digit in the dataset names where there was only 1 tank.
# that is SPN4 and SPC6
# unique(dat_select$dataset)
dat_select[grepl("SPN4|SPC6", dataset), dataset := sub("1$", "", dataset)]
dat_select <- dat_select[order(dataset, datetime),]
# mean by day rather than hour
dat_select[, ":="(doy = yday(datetime), year = year(datetime))]
dat_mean <- dat_select[
, lapply(.SD, mean, na.rm = TRUE),
by = .(doy, year, dataset),
.SDcols = is.numeric
]
dat_mean[, datetime := as.POSIXct(
paste(year, doy, "12:00:00"),
format = "%Y %j %H:%M:%S",
tz = "UTC"
)]
dat_select <- dat_mean[, .(datetime, CH4_emis_rate, NH3_emis_rate = NA, VFA_conc,
TAN_conc, slurry_mass, temp_C, pH, wash_water,
feed_intake, energy_content, animals, dataset)]
dat_select[, dataset := gsub('NA','', dataset)]
dat_select[, names(dat_select) := lapply(.SD, function(x) {
if (is.numeric(x)) x[is.nan(x)] <- NA
x
})]
write.xlsx(dat_select, '../output/emi_ABM_model_rdy.xlsx')
rm(list = ls())
source('run.R')
